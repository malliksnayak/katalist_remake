<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="1" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="projects"/></not>
        </preConditions>
        <createTable tableName="projects">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="original_story" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="scenes"/></not>
        </preConditions>
        <createTable tableName="scenes">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="VARCHAR(255)">
                <constraints nullable="false" foreignKeyName="fk_scene_project" referencedTableName="projects" referencedColumnNames="id"/>
            </column>
            <column name="scene_order" type="INT"/>
            <column name="visual_description" type="TEXT"/>
            <column name="audio_script" type="TEXT"/>
            <column name="duration_seconds" type="INT"/>
            <column name="image_prompt" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="3" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="audios"/></not>
        </preConditions>
        <createTable tableName="audios">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="scene_id" type="VARCHAR(36)">
                <constraints nullable="false" foreignKeyName="fk_audio_scene" referencedTableName="scenes" referencedColumnNames="id"/>
            </column>
            <column name="audio_base64" type="TEXT"/>
            <column name="mime_type" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="4" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="images"/></not>
        </preConditions>
        <createTable tableName="images">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="scene_id" type="VARCHAR(36)">
                <constraints nullable="false" foreignKeyName="fk_image_scene" referencedTableName="scenes" referencedColumnNames="id"/>
            </column>
            <column name="image_base64" type="TEXT"/>
            <column name="mime_type" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
